add table ip {{ libvirt_host_network_outbound_nat_table }}
add set ip {{ libvirt_host_network_outbound_nat_table }} lab_cidrs { type ipv4_addr; flags interval; }
add element ip {{ libvirt_host_network_outbound_nat_table }} lab_cidrs { {{ libvirt_host_network_scoped_nat_networks | map(attribute='cidr') | join(', ') }} }
add set ip {{ libvirt_host_network_outbound_nat_table }} lab_bridges { type ifname; }
add element ip {{ libvirt_host_network_outbound_nat_table }} lab_bridges { {{ libvirt_host_network_scoped_nat_networks | map(attribute='bridge_name') | map('to_json') | join(', ') }} }
add chain ip {{ libvirt_host_network_outbound_nat_table }} postrouting { type nat hook postrouting priority srcnat - 20; policy accept; }
add rule ip {{ libvirt_host_network_outbound_nat_table }} postrouting ip saddr @lab_cidrs ip daddr != @lab_cidrs oifname != @lab_bridges masquerade
